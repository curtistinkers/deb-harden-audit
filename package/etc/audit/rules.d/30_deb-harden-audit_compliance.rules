# =====================================================================
# 30-compliance.rules: Critical System Path & Identity Monitoring
# =====================================================================

# --- User Account & Identity Management Files ---
-w /etc/passwd -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/group -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes
-w /etc/security/opasswd -p wa -k identity_changes

# --- Privilege Escalation & Sudo Controls ---
-w /etc/sudoers -p wa -k privilege_escalation
-w /etc/sudoers.d/ -p wa -k privilege_escalation

# --- General Network Configuration ---
-w /etc/network/interfaces -p wa -k network_config_changes
-w /etc/hosts -p wa -k network_config_changes
-w /etc/resolv.conf -p wa -k network_config_changes

# --- Audit Infrastructure & Log Protection ---
-w /var/log/audit/ -p wa -k audit_log_tampering
-w /etc/audit/auditd.conf -p wa -k audit_config_changes

# --- Cron & Task Scheduler Persistence ---
-w /etc/crontab -p wa -k cron_persistence
-w /etc/cron.d/ -p wa -k cron_persistence
-w /etc/cron.daily/ -p wa -k cron_persistence
-w /etc/cron.hourly/ -p wa -k cron_persistence
-w /etc/cron.weekly/ -p wa -k cron_persistence
-w /etc/cron.monthly/ -p wa -k cron_persistence
